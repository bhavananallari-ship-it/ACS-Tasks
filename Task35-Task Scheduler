class Solution {
    public int leastInterval(char[] tasks, int n) {

        // Count frequency of each task
        int[] freq = new int[26];

        for (char task : tasks) {
            freq[task - 'A']++;
        }

        // Find the maximum frequency
        int maxFreq = 0;

        for (int count : freq) {
            maxFreq = Math.max(maxFreq, count);
        }

        // Number of tasks having maximum frequency
        int maxCount = 0;

        for (int count : freq) {
            if (count == maxFreq) {
                maxCount++;
            }
        }

        /*
         * Arrange the most frequent tasks first.
         *
         * (maxFreq - 1) = number of gaps between
         * occurrences of the most frequent task.
         *
         * Each gap has n idle/task positions.
         */
        int intervals = (maxFreq - 1) * (n + 1) + maxCount;

        // If there are enough different tasks to fill the gaps,
        // no idle time is needed.
        return Math.max(tasks.length, intervals);
    }
}
